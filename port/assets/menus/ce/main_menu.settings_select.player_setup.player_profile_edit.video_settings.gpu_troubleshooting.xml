		<string text=""/>
		<string text="Streamed: vertices sent each draw. Cached:\nkept on the GPU. From the next start."/>
		<string text="Off: draws without a base vertex, as older\nGPUs do (vertices streamed). From the next start."/>
		<string text="Off: the models' small vertex values read\ndirectly, not as whole words. From the next start."/>
		<string text="Off: normals and words read as floats, not\nintegers. From the next start."/>
		<string text="Safe: vertices written with plain GL copies,\nnot mapped memory. From the next start."/>
		<string text="On: draws use 32-bit vertex numbers, not\n16-bit ones. From the next start."/>
